NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI models, as comma-separated "provider:model" lists tried in order (see lib/ai.js).
# Providers: groq, cloudflare. Face analysis needs a vision model.
AI_VISION=groq:qwen/qwen3.8-27b
# Coach Maxy. A separate model has its own free quota. Leave empty to reuse AI_VISION.
AI_CHAT=
GROQ_API_KEY=
# Optional fallback provider (Cloudflare Workers AI).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MOCK_AI=false

# Vercel sends this automatically to /api/cron. Use a long random string.
CRON_SECRET=
# Salt for hashing IP addresses in the rate limiter. Use a long random string and keep it stable.
IP_HASH_SALT=
