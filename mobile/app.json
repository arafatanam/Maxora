{
  "expo": {
    "name": "Maxora",
    "slug": "maxora",
    "scheme": "maxora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#150D2E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arafatanam.maxora",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Maxora uses your camera to take the front and side photos for your face rating.",
        "NSPhotoLibraryUsageDescription": "Maxora reads photos you pick so it can rate your face.",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "com.arafatanam.maxora",
      "adaptiveIcon": {
        "backgroundColor": "#2B1B5A",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#2B1B5A"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Maxora uses your camera to take the front and side photos for your face rating.",
          "photosPermission": "Maxora reads photos you pick so it can rate your face.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "df4516ab-7825-4d2e-ba82-d6b460cd2af2"
      }
    },
    "owner": "arafatanam"
  }
}
